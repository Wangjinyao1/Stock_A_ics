# ============================================================
# Stock_A_ics 环境变量示例（复制为 .env 后按实际情况修改）
# ============================================================

# GitHub 仓库（订阅地址依赖该配置，格式：owner/repo）
GITHUB_REPO=your-name/Stock_A_ics
GITHUB_BRANCH=main

# 数据库（127.0.0.1）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_credential
DB_PASSWORD=your_db_credential
DB_NAME=your_db_credential
# 是否启用数据库持久化（1=启用，0=禁用；GitHub Actions 上应为 0）
DB_ENABLED=1

# 日历生成年份范围（只有上交所已公布休市安排的年份会被生成）
YEAR_FROM=2026
YEAR_TO=2028

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
